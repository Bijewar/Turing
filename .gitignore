# ============================================================
# TURING — CAUSAL NEXUS PROJECT .gitignore
# ============================================================

# ============================================================
# SECRETS & ENVIRONMENT VARIABLES (NEVER COMMIT)
# ============================================================
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
python-engine/.env
*.key
*.pem
*.p12
*.pfx
upload/

# Explicitly keep example environment templates
!.env.example
!python-engine/.env.example

# ============================================================
# NODE / NEXT.JS FRONTEND & DEPENDENCIES
# ============================================================
node_modules/
node_modules
*/node_modules/
**/node_modules/
Turing_Test_Suite/frontend/node_modules/
.next/
/.next/
out/
/out/
build/
/build
.vercel
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js

# ============================================================
# PYTHON ENGINE BACKEND
# ============================================================
venv/
.venv/
env/
venv*/
python-engine/venv/
python-engine/env/
python-engine/.venv/

# Byte-compiled / optimized / DLL files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Python distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/
*.manifest
*.spec

# Test coverage & Linter caches
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Local databases & model checkpoints
*.db
*.sqlite
*.sqlite3
python-engine/database/*.db
python-engine/database/*.sqlite3
python-engine/storage/**/*.joblib

# ============================================================
# JUPYTER & LOGS
# ============================================================
.ipynb_checkpoints/
*.ipynb
*.log
layer2_audit.log
layer2_errors.json

# ============================================================
# OPERATING SYSTEM SPECIFIC
# ============================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ============================================================
# EDITORS & IDEs
# ============================================================
.idea/
*.iml
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ============================================================
# TEMPORARY & GENERATED DIRECTORIES
# ============================================================
upload/
scratch/
uploads/
data/raw/